{
  "name": "email-management-saas",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');for(const f of['package-lock.json','yarn.lock'])fs.rmSync(f,{force:true});if(!String(process.env.npm_config_user_agent).startsWith('pnpm/')){console.error('Use pnpm instead');process.exit(1)}\"",
    "setup": "node scripts/tasks.mjs setup",
    "dev": "node scripts/tasks.mjs dev",
    "dev:api": "node scripts/tasks.mjs api",
    "dev:web": "pnpm --filter frontend run dev",
    "db:start": "node scripts/tasks.mjs db:start",
    "db:stop": "node scripts/tasks.mjs db:stop",
    "db:status": "node scripts/tasks.mjs db:status",
    "db:migrate": "node scripts/tasks.mjs migrate",
    "test": "node scripts/tasks.mjs test",
    "typecheck": "pnpm --filter frontend run typecheck",
    "build": "pnpm run typecheck && pnpm --filter frontend run build"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
