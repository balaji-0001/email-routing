# Copy this file to .env and adjust. Everything has a working default for local
# development, so .env is only needed for what you want to change.

# --- API (FastAPI) --------------------------------------------------------
PORT=5000
LOG_LEVEL=info
# "production" turns on secure cookies and turns off the API docs page.
APP_ENV=development
# Where the web app is served. Used for links in emails, and requests that
# change something are only accepted from this address.
APP_URL=http://localhost:5173
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3308/email_management
# For a hosted database: DATABASE_SSL=true makes the connection encrypted and checks the server's identity.
# DATABASE_CA is the provider's certificate (the PEM text, on one line with \n for line breaks) if it gives you one.
# DATABASE_SSL=true
# DATABASE_CA=

# --- Local MySQL, started by `pnpm db:start` ------------------------------
# Folder of a MySQL 8 server (the one that contains bin/mysqld). Leave empty if
# mysqld is on your PATH or a server is unpacked into ./local-mysql/server.
MYSQL_HOME=

# --- Outgoing email -------------------------------------------------------
# Password reset is reported as unavailable until SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Gmail by Google sign-in ----------------------------------------------
# From a Google Cloud OAuth client of type "Web application" (steps in README.md).
# Connecting with Google is reported as unavailable until both are set.
# Redirect address to register with Google: {APP_URL}/api/v1/email-accounts/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI summaries, priority and reply drafts (Google Gemini). Get a key at https://aistudio.google.com/apikey
# Leave empty to keep AI off. AI_MODEL is optional.
GEMINI_API_KEY=
# AI_MODEL=gemini-3.5-flash-lite

# --- Stored mailbox passwords and tokens ----------------------------------
# A long random secret that encrypts them in the database. Without it the key is
# derived from DATABASE_URL, which is fine on your own machine but not for a
# real deployment. Secrets saved before this was set stay readable.
ENCRYPTION_KEY=

# --- Web app (Vite dev server) --------------------------------------------
WEB_PORT=5173
BASE_PATH=/
